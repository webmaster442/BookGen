# .env file example for configuring BookGen settings
# To specify a custom .env file use the -env or --env-file option when running BookGen.
# Uncomment and set the following variables to customize your BookGen environment.
# --------------------------------------------------------------------------------

# Custom Node.js path (optional. If not set, the default system Node.js will be used from PATH)
#NodeJsPath=/path/to/custom/nodejs

# Custom Python path (optional. If not set, the default system Python will be used from PATH)
#PythonPath=/path/to/custom/python

# Custom PlantUML path (optional. If not set, the default system PlantUML will be used from PATH)
#PlantUmlPath=/path/to/custom/plantuml

# Custom Ratex path (optional. If not set, the default system Ratex will be used from Bookgen folder)
#RatexPath=/path/to/custom/ratex

# Custom Mmdr path (optional. If not set, the default system Mmdr will be used from Bookgen folder)
#MmdrPath=/path/to/custom/mmdr
